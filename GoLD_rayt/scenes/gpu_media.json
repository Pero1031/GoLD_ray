// A test scene of the kernel renderer (docs/GPU.md): the box of scenes/gpu_box.json with three glass bodies filled with scattering media
// (Materials/Medium.hpp) - a jade ball (green: the extinction and the albedo differ per channel, so the walk has a hero channel and
// weights), a milk ball behind a rough boundary with a two-lobe phase function (forward and backward), and a turned marble vase whose
// medium has a noise density (null collisions). Everything in it is what --device gpu / cpu-kernel model, so the engine and the kernel
// renderer must converge to the same picture.
{
 "options": { "width": 400, "height": 300, "spp": 64 },
 "camera": { "from": [0, 1, 3.6], "at": [0, 0.8, 0], "fov": 40 },
 "environment": { "type": "uniform", "scale": 0.1 },
 "materials": {
  "white": { "type": "diffuse", "albedo": [0.75, 0.75, 0.72] },
  "red": { "type": "diffuse", "albedo": [0.63, 0.065, 0.05] },
  "green": { "type": "diffuse", "albedo": [0.14, 0.45, 0.09] },
  "jade": { "type": "dielectric", "ior": 1.6, "roughness": 0,
            "medium": { "sigmaT": [120, 70, 120], "albedo": [0.85, 0.995, 0.93], "g": 0.3 } },
  "milk": { "type": "dielectric", "ior": 1.35, "roughness": 0.15,
            "medium": { "sigmaT": 90, "albedo": 0.99, "g": 0.8, "g2": -0.3, "weight": 0.9 } },
  "marble": { "type": "dielectric", "ior": 1.5, "roughness": 0,
              "medium": { "sigmaT": [200, 200, 170], "albedo": [0.99, 0.985, 0.97], "g": 0.2,
                          "noise": { "frequency": 30, "octaves": 3, "lo": 0.3, "hi": 0.6, "seed": 5 } } },
  "lamp": { "type": "emission", "spectrum": { "rgb": [1, 0.9, 0.75] }, "radiance": 18 }
 },
 "objects": [
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [2, 0, 0], "edge2": [0, 0, -2], "material": "white" },
  { "shape": "quad", "corner": [-1, 2, 1], "edge1": [0, 0, -2], "edge2": [2, 0, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, -1], "edge1": [2, 0, 0], "edge2": [0, 2, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [0, 0, -2], "edge2": [0, 2, 0], "material": "red" },
  { "shape": "quad", "corner": [1, 0, -1], "edge1": [0, 0, 2], "edge2": [0, 2, 0], "material": "green" },
  { "shape": "quad", "corner": [-0.3, 1.98, 0.3], "edge1": [0, 0, -0.6], "edge2": [0.6, 0, 0], "material": "lamp", "light": true },
  { "shape": "sphere", "center": [-0.5, 0.22, 0.3], "radius": 0.22, "material": "jade" },
  { "shape": "sphere", "center": [0.5, 0.24, 0.2], "radius": 0.24, "material": "milk" },
  { "shape": "lathe", "profile": [[0, 0.001], [0.2, 0.001], [0.26, 0.12], [0.24, 0.4], [0.14, 0.62], [0.12, 0.7], [0.15, 0.74], [0, 0.74]], "segments": 64,
    "translate": [0, 0, -0.45], "material": "marble" }
 ]
}
