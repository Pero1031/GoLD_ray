// A test scene of the kernel renderer (docs/GPU.md): the box of scenes/gpu_box.json with four clear coats (Materials/LayeredCoat.hpp)
// - a red lacquered ball (a smooth coat over a diffuse base), a turned gold vase under a clear coat (a metal base in the coat's medium),
// an amber-tinted varnish on a white panel leaning on the back wall, and a blue ball under a satin coat evaluated with two walks.
// Everything in it is what --device gpu / cpu-kernel model, so the engine and the kernel renderer must converge to the same picture.
{
 "options": { "width": 400, "height": 300, "spp": 64 },
 "camera": { "from": [0, 1, 3.6], "at": [0, 0.95, 0], "fov": 40 },
 "environment": { "type": "uniform", "scale": 0.1 },
 "materials": {
  "white": { "type": "diffuse", "albedo": [0.75, 0.75, 0.72] },
  "red": { "type": "diffuse", "albedo": [0.63, 0.065, 0.05] },
  "green": { "type": "diffuse", "albedo": [0.14, 0.45, 0.09] },
  "lacquer": { "type": "layered", "coat": { "ior": 1.5, "roughness": 0.05 }, "base": { "albedo": [0.6, 0.05, 0.04] } },
  "gold_clear": { "type": "layered", "coat": { "ior": 1.5, "roughness": 0.04 }, "base": { "metal": "Au", "roughness": 0.2 } },
  "amber": { "type": "layered", "coat": { "ior": 1.5, "roughness": 0.1, "tint": [1.0, 0.72, 0.3] }, "base": { "albedo": [0.8, 0.8, 0.78] } },
  "satin": { "type": "layered", "coat": { "ior": 1.5, "roughness": 0.3, "samples": 2 }, "base": { "albedo": [0.08, 0.18, 0.55] } },
  "lamp": { "type": "emission", "spectrum": { "rgb": [1, 0.9, 0.75] }, "radiance": 18 }
 },
 "objects": [
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [2, 0, 0], "edge2": [0, 0, -2], "material": "white" },
  { "shape": "quad", "corner": [-1, 2, 1], "edge1": [0, 0, -2], "edge2": [2, 0, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, -1], "edge1": [2, 0, 0], "edge2": [0, 2, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [0, 0, -2], "edge2": [0, 2, 0], "material": "red" },
  { "shape": "quad", "corner": [1, 0, -1], "edge1": [0, 0, 2], "edge2": [0, 2, 0], "material": "green" },
  { "shape": "quad", "corner": [-0.3, 1.98, 0.3], "edge1": [0, 0, -0.6], "edge2": [0.6, 0, 0], "material": "lamp", "light": true },
  { "shape": "lathe", "profile": [[0, 0], [0.2, 0], [0.26, 0.12], [0.24, 0.4], [0.14, 0.62], [0.12, 0.7], [0.15, 0.74], [0, 0.74]], "segments": 64,
    "translate": [0.05, 0, -0.2], "material": "gold_clear" },
  { "shape": "quad", "corner": [-0.9, 0.0, -0.55], "edge1": [0.5, 0, 0], "edge2": [0, 0.9, -0.3], "material": "amber" },
  { "shape": "sphere", "center": [-0.5, 0.2, 0.45], "radius": 0.2, "material": "lacquer" },
  { "shape": "sphere", "center": [0.55, 0.22, 0.3], "radius": 0.22, "material": "satin" }
 ]
}
