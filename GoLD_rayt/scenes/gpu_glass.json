// The third test scene of the kernel renderer (docs/GPU.md): the box of scenes/gpu_box.json with a smooth glass vase (a closed
// lathe, index 1.5) and a frosted glass cube (six quads facing out, index 1.5, roughness 0.25) standing on the floor. Everything
// in it is what --device gpu / cpu-kernel model (dielectrics without dispersion or a medium inside), so the engine and the kernel
// renderer must converge to the same picture. The caustics under the glass are found by BSDF sampling only, in both. The floor is
// 1 mm below the vase: a glass bottom lying in the floor's plane would be two coincident surfaces, which Embree and OptiX settle
// differently (both rightly), so the CPU's and the GPU's paths would part there.
{
 "options": { "width": 400, "height": 300, "spp": 64 },
 "camera": { "from": [0, 1, 3.6], "at": [0, 0.95, 0], "fov": 40 },
 "environment": { "type": "uniform", "scale": 0.1 },
 "materials": {
  "white": { "type": "diffuse", "albedo": [0.75, 0.75, 0.72] },
  "red": { "type": "diffuse", "albedo": [0.63, 0.065, 0.05] },
  "green": { "type": "diffuse", "albedo": [0.14, 0.45, 0.09] },
  "glass": { "type": "dielectric", "ior": 1.5, "roughness": 0 },
  "frosted": { "type": "dielectric", "ior": 1.5, "roughness": 0.25 },
  "lamp": { "type": "emission", "spectrum": { "rgb": [1, 0.9, 0.75] }, "radiance": 18 }
 },
 "objects": [
  { "shape": "quad", "corner": [-1, -0.001, 1], "edge1": [2, 0, 0], "edge2": [0, 0, -2], "material": "white" },
  { "shape": "quad", "corner": [-1, 2, 1], "edge1": [0, 0, -2], "edge2": [2, 0, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, -1], "edge1": [2, 0, 0], "edge2": [0, 2, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [0, 0, -2], "edge2": [0, 2, 0], "material": "red" },
  { "shape": "quad", "corner": [1, 0, -1], "edge1": [0, 0, 2], "edge2": [0, 2, 0], "material": "green" },
  { "shape": "quad", "corner": [-0.3, 1.98, 0.3], "edge1": [0, 0, -0.6], "edge2": [0.6, 0, 0], "material": "lamp", "light": true },
  { "shape": "lathe", "profile": [[0, 0], [0.2, 0], [0.26, 0.12], [0.24, 0.4], [0.14, 0.62], [0.12, 0.7], [0.15, 0.74], [0, 0.74]], "segments": 64, "material": "glass" },
  { "shape": "quad", "corner": [0.35, 0.0005, 0.0], "edge1": [0.35, 0, 0], "edge2": [0, 0, 0.35], "material": "frosted" },
  { "shape": "quad", "corner": [0.35, 0.3505, 0.0], "edge1": [0, 0, 0.35], "edge2": [0.35, 0, 0], "material": "frosted" },
  { "shape": "quad", "corner": [0.35, 0.0005, 0.35], "edge1": [0.35, 0, 0], "edge2": [0, 0.35, 0], "material": "frosted" },
  { "shape": "quad", "corner": [0.35, 0.0005, 0.0], "edge1": [0, 0.35, 0], "edge2": [0.35, 0, 0], "material": "frosted" },
  { "shape": "quad", "corner": [0.35, 0.0005, 0.0], "edge1": [0, 0, 0.35], "edge2": [0, 0.35, 0], "material": "frosted" },
  { "shape": "quad", "corner": [0.7, 0.0005, 0.0], "edge1": [0, 0.35, 0], "edge2": [0, 0, 0.35], "material": "frosted" }
 ]
}
