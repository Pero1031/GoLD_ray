{
  // A gold bowl with a gold ball in it, a white reference ball and a gray floor under one tungsten bulb.
  // The same scene as the built-in "goldbowl" with --light tungsten. Change "spectrum" to "d65", "candle" or "led" for another light.
  "options": { "width": 800, "spp": 256 },
  "camera": { "from": [0.02, 0.27, 0.33], "at": [0.035, 0.035, 0], "fov": 30 },
  "materials": {
    "gold":  { "type": "conductor", "metal": "Au", "roughness": 0.12 },
    "white": { "type": "diffuse", "albedo": 0.8 },
    "floor": { "type": "diffuse", "albedo": 0.5 },
    "bulb":  { "type": "emission", "spectrum": "tungsten", "radiance": 90 },
    // a dim glow of the same spectrum all around, so that the inside of the bowl has something to reflect (not a light to sample)
    "glow":  { "type": "emission", "spectrum": "tungsten", "radiance": 0.25, "twoSided": true }
  },
  "objects": [
    { "shape": "lathe", "profile": { "shell": { "radius": 0.08, "wall": 0.003, "endDegrees": 78, "steps": 40 } }, "segments": 96, "material": "gold" },
    { "shape": "sphere", "center": [0, 0.0315, 0], "radius": 0.028, "material": "gold" },
    { "shape": "sphere", "center": [0.13, 0.025, 0.03], "radius": 0.025, "material": "white" },
    { "shape": "sphere", "center": [0, -100, 0], "radius": 100, "material": "floor" },
    { "shape": "sphere", "center": [-0.18, 0.20, 0.10], "radius": 0.03, "material": "bulb" },
    { "shape": "sphere", "center": [0, 0, 0], "radius": 20, "material": "glow", "light": false }
  ]
}