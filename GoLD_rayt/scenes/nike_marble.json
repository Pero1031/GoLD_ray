{
  // The Winged Victory of Samothrace (a 500 000-triangle STL scan, closed; assets/winged-victory-of-samothrace-at-the-louvre-paris-1.stl is not part
  // of the repository: put your own STL there) in marble: a polished refractive boundary over a nearly non-absorbing scattering medium with a
  // noise density (the marble of scenes/erato_translucent.json), lit by a church light probe (assets/env/grace-new.hdr, also not in the
  // repository) and a lamp behind and above the statue, through which the thin parts (the wing, the drapery) glow. Spectral build.
  // The scan is in mm with Z up: scaled to 0.5 m and turned so that Z becomes Y; the translate centers it (its box is 1900 x 2127 x 2928 mm).
  "environment": { "type": "hdr", "file": "assets/env/grace-new.hdr", "scale": 1.2 },
  "options": { "width": 600, "height": 800, "spp": 128, "depth": 48, "denoise": true },
  "camera": { "from": [0.25, 0.30, 1.15], "at": [-0.07, 0.24, 0.0], "fov": 32 },
  "materials": {
    "marble": { "type": "dielectric", "ior": 1.55, "roughness": 0.12,
                "medium": { "sigmaT": 480, "albedo": [0.9985, 0.9985, 0.9990], "g": 0.2,
                            "noise": { "frequency": 55, "octaves": 4, "lo": 0.30, "hi": 0.62, "seed": 5 } } },
    "floor":  { "type": "diffuse", "albedo": 0.35 },
    "lamp":   { "type": "emission", "spectrum": "tungsten", "radiance": 60 }
  },
  "objects": [
    { "shape": "mesh", "file": "assets/winged-victory-of-samothrace-at-the-louvre-paris-1.stl", "scale": 0.000171,
      "rotate": { "axis": [1, 0, 0], "degrees": -90 }, "translate": [-0.0771, 0.0, 0.1153], "material": "marble" },
    { "shape": "sphere", "center": [0, -100, 0], "radius": 100, "material": "floor" },
    { "shape": "sphere", "center": [-0.5, 1.05, -0.7], "radius": 0.13, "material": "lamp" },
    { "shape": "sphere", "center": [-0.5, 0.6, 0.6], "radius": 0.06, "material": "lamp" }
  ]
}
