  { "shape": "quad", "corner": [-0.75, 0.0, 0.1], "edge1": [0.3, 0, 0], "edge2": [0, 0.3, 0], "material": "white" },
  { "shape": "quad", "corner": [-0.75, 0.0, -0.2], "edge1": [0, 0.3, 0], "edge2": [0.3, 0, 0], "material": "white" },
  { "shape": "quad", "corner": [-0.75, 0.0, -0.2], "edge1": [0, 0, 0.3], "edge2": [0, 0.3, 0], "material": "white" },
