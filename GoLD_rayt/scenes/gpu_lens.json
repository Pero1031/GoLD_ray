// A test scene of the kernel renderer (docs/GPU.md): the spheres of scenes/gpu_spheres.json seen through a real lens traced surface by
// surface - the double Gauss 50 mm (assets/Lenses/dgauss_50mm.txt) at f/2.8 with seven blades, focused on the gold ball. Everything in
// it is what --device gpu / cpu-kernel model, so the engine and the kernel renderer must converge to the same picture.
{
 "options": { "width": 400, "height": 300, "spp": 64 },
 "camera": { "from": [0, 0.9, 3.4], "at": [0, 0.6, 0], "lens": "assets/Lenses/dgauss_50mm.txt", "fStop": 2.8, "blades": 7, "focusAt": [0.15, 0.3, -0.45] },
 "environment": { "type": "uniform", "scale": 0.1 },
 "materials": {
  "white": { "type": "diffuse", "albedo": [0.75, 0.75, 0.72] },
  "red": { "type": "diffuse", "albedo": [0.63, 0.065, 0.05] },
  "green": { "type": "diffuse", "albedo": [0.14, 0.45, 0.09] },
  "clay": { "type": "diffuse", "albedo": [0.7, 0.55, 0.4] },
  "gold": { "type": "conductor", "metal": "Au", "roughness": 0.2 },
  "glass": { "type": "dielectric", "ior": 1.5, "roughness": 0 },
  "frosted": { "type": "dielectric", "ior": 1.5, "roughness": 0.25 },
  "lamp": { "type": "emission", "spectrum": { "rgb": [1, 0.9, 0.75] }, "radiance": 20 },
  "ember": { "type": "emission", "spectrum": { "rgb": [1, 0.45, 0.12] }, "radiance": 120 }
 },
 "objects": [
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [2, 0, 0], "edge2": [0, 0, -2], "material": "white" },
  { "shape": "quad", "corner": [-1, 2, 1], "edge1": [0, 0, -2], "edge2": [2, 0, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, -1], "edge1": [2, 0, 0], "edge2": [0, 2, 0], "material": "white" },
  { "shape": "quad", "corner": [-1, 0, 1], "edge1": [0, 0, -2], "edge2": [0, 2, 0], "material": "red" },
  { "shape": "quad", "corner": [1, 0, -1], "edge1": [0, 0, 2], "edge2": [0, 2, 0], "material": "green" },
  { "shape": "sphere", "center": [0, 1.7, -0.1], "radius": 0.15, "material": "lamp" },
  { "shape": "sphere", "center": [0.85, 0.5, -0.6], "radius": 0.04, "material": "ember" },
  { "shape": "sphere", "center": [-0.55, 0.28, -0.25], "radius": 0.28, "material": "clay" },
  { "shape": "sphere", "center": [0.15, 0.3, -0.45], "radius": 0.3, "material": "gold" },
  { "shape": "sphere", "center": [0.5, 0.22, 0.25], "radius": 0.22, "material": "glass" },
  { "shape": "sphere", "center": [-0.2, 0.18, 0.35], "radius": 0.18, "material": "frosted" }
 ]
}
